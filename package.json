{
  "name": "neug-webpage",
  "version": "1.0.0",
  "private": true,
  "description": "The unified NeuG website, documentation, and blog",
  "scripts": {
    "dev": "node --require ./scripts/polyfill-localstorage.js node_modules/.bin/next dev",
    "build": "npm run validate:content && node --require ./scripts/polyfill-localstorage.js node_modules/.bin/next build && node scripts/prepare-static-export.mjs && pagefind --site out --output-subdir _pagefind",
    "serve": "npx serve out",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "sync:docs": "node scripts/sync-neug-docs.mjs && node scripts/translate-neug-docs.mjs"
  },
  "keywords": [
    "neug",
    "graph-database",
    "htap",
    "documentation",
    "translation",
    "ai",
    "nextra"
  ],
  "author": "NeuG Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dotenv": "^16.6.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.539.0",
    "next": "^14.0.0",
    "next-themes": "^0.4.6",
    "nextra": "^4.3.0",
    "nextra-theme-docs": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.2.4"
  },
  "devDependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "24.3.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "pagefind": "^1.3.0",
    "raw-loader": "^4.0.2",
    "react-day-picker": "^9.9.0",
    "tailwindcss": "^4.1.10",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.0.0",
    "tsx": "^4.6.0",
    "typescript": "^5.0.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
